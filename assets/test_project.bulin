{
  "version": 1,
  "shader": "@fragment\nfn fs_main(@location(0) uv: vec2<f32>) -> @location(0) vec4<f32> {\n    let time = customs.time;\n    let radius = customs.radius;\n    let leaves = customs.leaves;\n    let speed = customs.speed;\n    let flower_color = vec3<f32>(0.9, 0.1, 0.2);\n    let test = vec3<f32>(0.1, 0.2, 0.1);\n\n    let st = uv;\n\n    let d = 0.25 + 0.5 * (0.5 + 0.5 * sin(2.0 * time));\n    let pos = vec2<f32>(d) - st;\n\n    let r = (2.0 + sin(9.0 * time)) / radius * length(pos) * 1.2;\n    let a = atan2(pos.y, pos.x);\n\n    let f = abs(cos(a * leaves / 2.0 + speed * time)) * 0.5 + 0.3;\n    let ratio = smoothstep(f, f + 0.02, r);\n    let color = flower_color * (1.0 - ratio);\n    let back = test * ratio;\n\n    return vec4<f32>(color + back, 1.0);\n}\n",
  "uniforms": [
    {
      "name": "radius",
      "value": {
        "Float": 0.5
      }
    },
    {
      "name": "leaves",
      "value": {
        "Float": 5.0
      }
    },
    {
      "name": "speed",
      "value": {
        "Float": 10.0
      }
    }
  ],
  "clock": {
    "elapsed": {
      "secs": 76,
      "nanos": 280044834
    },
    "running": true
  }
}
